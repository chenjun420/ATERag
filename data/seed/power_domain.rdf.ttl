ns1:err%3A%3AE-1 a ns1:Erratum ;
    ns1:authority_kind "unverified" ;
    ns1:name "E-1" ;
    ns1:statement "：常见误表述：把 KVL 标注为「能量守恒：ΣV = 0」。**这是错的**。KVL 是独立的电压守恒公理；能量守恒是 A-3；Tellegen 定理（T1）是 A-1 与 A-2 的推论。三者不可混同。" .

ns1:err%3A%3AE-2 a ns1:Erratum ;
    ns1:authority_kind "unverified" ;
    ns1:name "E-2" ;
    ns1:statement "：常见误表述「电感中电流不能突变……类似于电流源」。**两处错误**：" .

ns1:err%3A%3AE-3 a ns1:Erratum ;
    ns1:authority_kind "unverified" ;
    ns1:name "E-3" ;
    ns1:statement "：常见误表述「电容两端电压不能突变……类似于电压源」。**两处错误**：" .

ns1:err%3A%3AE-4 a ns1:Erratum ;
    ns1:authority_kind "unverified" ;
    ns1:name "E-4" ;
    ns1:statement "：常见误表述：把「当电感足够大时可认为电流不变」当作公理。**这是工程近似**，不是公理。它有明确的适用条件与误差量级。" .

ns1:err%3A%3AE-5 a ns1:Erratum ;
    ns1:authority_kind "unverified" ;
    ns1:name "E-5" ;
    ns1:statement "：易混淆的写法 `G_c(s) = (ω_z/s)·(1+s/ω_z)/(1+s/ω_p)`，其中零点被计入两次（`ω_z/s` 已含一个零点，再乘 `(1+s/ω_z)` 重复）。正确标准式如下。" .

ns1:err%3A%3AE-6 a ns1:Erratum ;
    ns1:authority_kind "unverified" ;
    ns1:name "E-6" ;
    ns1:statement "：易混淆的写法 `P_total = Σ P_i · K_simult，K_simult 典型 0.7~0.9`，把两个不同概念混为一谈，且方向反了。" .

ns1:err%3A%3AE-7 a ns1:Erratum ;
    ns1:authority_kind "unverified" ;
    ns1:name "E-7" ;
    ns1:statement "：易混淆的写法 `λ = λ_base · π_T · π_S · π_Q`（四因子）。MIL-HDBK-217F Part Stress 法实为**七因子**乘积。四因子模型无法支撑降额分析（缺环境因子 π_E）与等级调整（缺 π_C）。" .

ns1:load%3A%3A%E5%8D%8A%E8%BD%BD a ns1:LoadCondition ;
    ns1:authority_kind "industry" ;
    ns1:authority_ref "用户给定定义(2026-10-04 会话确认)" ;
    ns1:derivation "满载 × 50%" ;
    ns1:en "half load" ;
    ns1:kind "load" ;
    ns1:name "半载" ;
    ns1:note "= 50%载 = 满载 × 50%。" ;
    ns1:ratio 0.5 .

ns1:load%3A%3A%E6%9C%80%E5%A4%A7%E9%A2%9D%E5%AE%9A a ns1:LoadCondition ;
    ns1:authority_kind "project_defined" ;
    ns1:en "absolute maximum rating" ;
    ns1:kind "rating" ;
    ns1:name "最大额定" ;
    ns1:note "超过即可能损坏的绝对上限, 与「额定工作值」不是一回事。" .

ns1:load%3A%3A%E6%9C%80%E5%B0%8F%E8%BD%BD a ns1:LoadCondition ;
    ns1:authority_kind "project_defined" ;
    ns1:en "minimum load" ;
    ns1:kind "load" ;
    ns1:name "最小载" ;
    ns1:note "比例待确认: 最小稳定负载由具体拓扑决定, 不是常数。收录但不给比例 —— 编一个数会让规则在错误工况上运行且不报错。" .

ns1:load%3A%3A%E6%A0%87%E7%A7%B0 a ns1:LoadCondition ;
    ns1:authority_kind "project_defined" ;
    ns1:en "nominal" ;
    ns1:kind "nominal" ;
    ns1:name "标称" ;
    ns1:note "常规取整的代表值, 无保证含义。不给比例。" .

ns1:load%3A%3A%E6%BB%A1%E8%BD%BD a ns1:LoadCondition ;
    ns1:authority_kind "project_defined" ;
    ns1:en "full load" ;
    ns1:kind "load" ;
    ns1:name "满载" ;
    ns1:note "归一化基准。任何 xx%载 都相对它折算。" ;
    ns1:ratio 1.0 .

ns1:load%3A%3A%E7%A9%BA%E8%BD%BD a ns1:LoadCondition ;
    ns1:authority_kind "project_defined" ;
    ns1:en "no load" ;
    ns1:kind "load" ;
    ns1:name "空载" ;
    ns1:note "输出为 0。「空载」不等于「轻载」: 空载下常降频, 损耗模型不适用同一套参数。" ;
    ns1:ratio 0.0 .

ns1:load%3A%3A%E9%A2%9D%E5%AE%9A a ns1:LoadCondition ;
    ns1:authority_kind "project_defined" ;
    ns1:en "rated" ;
    ns1:kind "rating" ;
    ns1:name "额定" ;
    ns1:note "保证工作点/保证极限。与「标称」不同, 不可互换。不给比例。" .

ns1:load%3A%3Axx%25%E8%BD%BD a ns1:LoadCondition ;
    ns1:authority_kind "industry" ;
    ns1:authority_ref "用户给定定义(2026-10-04 会话确认)" ;
    ns1:derivation "满载 × xx%" ;
    ns1:en "fraction load" ;
    ns1:kind "load" ;
    ns1:name "xx%载" ;
    ns1:note "**按模式求值, 不是固定值**: xx%载 = 满载 × xx%。例 30%载 -> 0.30。ratio 刻意为 null —— 它是待求量, 不是常量; 给出 1.0 之类的值会让推理把任意百分比都当成满载。整串锚定以免把 P_load 的 load 误认成工况词。" ;
    ns1:pattern "^(\\d+(?:\\.\\d+)?)\\s*%\\s*载$" .

ns1:loadratio%3A%3Afull_load a ns1:LoadRatio ;
    ns1:authority_kind "project_defined" ;
    ns1:load "full_load" ;
    ns1:name "load_ratio(full_load, 1.0)" ;
    ns1:ratio 1.0 .

ns1:loadratio%3A%3Ahalf_load a ns1:LoadRatio ;
    ns1:authority_kind "project_defined" ;
    ns1:load "half_load" ;
    ns1:name "load_ratio(half_load, 0.5)" ;
    ns1:ratio 0.5 .

ns1:loadratio%3A%3Ano_load a ns1:LoadRatio ;
    ns1:authority_kind "project_defined" ;
    ns1:load "no_load" ;
    ns1:name "load_ratio(no_load, 0.0)" ;
    ns1:ratio 0.0 .

