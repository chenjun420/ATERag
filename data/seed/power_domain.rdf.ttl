ns1:F_W.10.1_CAPACITIVE_COUPLING a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "i_n = C_c·dv/dt，dv/dt = ΔV/t_r" ;
