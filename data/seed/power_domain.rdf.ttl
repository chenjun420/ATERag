ns1:F_J.3_INDUCTOR_RIPPLE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[V]/([H]·[Hz]) = [V]·[Ω]·[s]/([V·s/A]·[1/s]) = [A]" ;
    ns1:domain "J" ;
    ns1:expr "ΔI_L = (V_on·D)/(L·f_sw)" ;
    ns1:name "F_J.3_INDUCTOR_RIPPLE" ;
    ns1:section "J.3" .

ns1:F_K.3_PHASE_MARGIN a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "P3（PM ≥ 45°）" ;
    ns1:name "F_K.3_PHASE_MARGIN" ;
    ns1:section "K.3" .

ns1:F_K.6_FILTER_CRITERION a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "≤ \\" ;
    ns1:name "F_K.6_FILTER_CRITERION" ;
    ns1:section "K.6" .

ns1:F_M.1_SAMPLING a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "M" ;
    ns1:expr "f_s ≥ k·f_max，k = 5~10" ;
    ns1:name "F_M.1_SAMPLING" ;
    ns1:section "M.1" .

ns1:F_N.2_LOSS_BUDGET a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "N" ;
    ns1:expr "P_loss,max = (T_max − T_a)/R_θ,total" ;
    ns1:name "F_N.2_LOSS_BUDGET" ;
    ns1:section "N.2" .

ns1:F_W.9.1_THD a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "THD = √(Σ_{n≥2} X_n²)/X_1" ;
    ns1:name "F_W.9.1_THD" ;
    ns1:section "W.9.1" .

