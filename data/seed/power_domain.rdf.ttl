    ns1:section "W.7.13" .

ns1:F_W.7.14_GATE_LOSS a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "P_gate = Q_g·V_GS·f_sw" ;
    ns1:name "F_W.7.14_GATE_LOSS" ;
    ns1:section "W.7.14" .

ns1:F_W.7.15_SWITCHING_LOSS a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "P_sw = ½(E_on+E_off)·f_sw ≈ ½·V_DS·I_D·(t_r+t_f)·f_sw" ;
    ns1:name "F_W.7.15_SWITCHING_LOSS" ;
    ns1:section "W.7.15" .

ns1:F_W.7.16_CONDUCTION_LOSS a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "P_cond = I_rms²·R_DS(on)·D，I_rms = √(I_L²+ΔI_L²/12)" ;
    ns1:name "F_W.7.16_CONDUCTION_LOSS" ;
    ns1:section "W.7.16" .

ns1:F_W.7.17_MILLER_CLAMP a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:name "F_W.7.17_MILLER_CLAMP" ;
    ns1:section "W.7.17" .

ns1:F_W.7.18_BODY_DIODE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "V_F = 0.5~0.8 V（硅 MOSFET），方向由源漏决定" ;
    ns1:name "F_W.7.18_BODY_DIODE" ;
    ns1:section "W.7.18" .

ns1:F_W.7.19_SOA a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:name "F_W.7.19_SOA" ;
    ns1:section "W.7.19" .

ns1:F_W.7.1_DIODE_IV a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "正向：V_F = n·V_T·ln(I/I_S)；V_T = kT/q" ;
    ns1:name "F_W.7.1_DIODE_IV" ;
    ns1:section "W.7.1" .

ns1:F_W.7.20_AVALANCHE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "V_DS ≥ BV_DSS 时击穿；耗散 E = ½·BV·I·t_av" ;
    ns1:name "F_W.7.20_AVALANCHE" ;
    ns1:section "W.7.20" .

ns1:F_W.7.21_AVALANCHE_REPETITION a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "累积能量 Σ E ≤ E_rated" ;
    ns1:name "F_W.7.21_AVALANCHE_REPETITION" ;
    ns1:section "W.7.21" .

ns1:F_W.7.22_BJT_FORCED_BETA a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "β_forced = I_C/I_B > 20（避免饱和深存储）" ;
    ns1:name "F_W.7.22_BJT_FORCED_BETA" ;
    ns1:section "W.7.22" .

ns1:F_W.7.23_BJT_STORAGE_TIME a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "t_st ≈ β_forced·τ_B" ;
    ns1:name "F_W.7.23_BJT_STORAGE_TIME" ;
    ns1:section "W.7.23" .

ns1:F_W.7.24_IGBT_TAIL a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:name "F_W.7.24_IGBT_TAIL" ;
    ns1:section "W.7.24" .

ns1:F_W.7.25_SIC_BJT_RDS a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:name "F_W.7.25_SIC_BJT_RDS" ;
    ns1:section "W.7.25" .

ns1:F_W.7.2_IDEAL_DIODE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "V_F ≈ 0.7 V（硅）" ;
    ns1:name "F_W.7.2_IDEAL_DIODE" ;
    ns1:section "W.7.2" .

ns1:F_W.7.3_SCHOTTKY_VF a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "V_F ≈ 0.3 ~ 0.5 V" ;
    ns1:name "F_W.7.3_SCHOTTKY_VF" ;
    ns1:section "W.7.3" .

ns1:F_W.7.4_REVERSE_RECOVERY a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:name "F_W.7.4_REVERSE_RECOVERY" ;
    ns1:section "W.7.4" .

ns1:F_W.7.5_RECTIFIER_RIPPLE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "V_r(pp) ≈ I/(f·C)" ;
    ns1:name "F_W.7.5_RECTIFIER_RIPPLE" ;
    ns1:section "W.7.5" .

ns1:F_W.7.6_FULL_WAVE_RIPPLE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "V_r(pp) ≈ 2I/(2·f_line·C)（整流后频率 2f_line）" ;
    ns1:name "F_W.7.6_FULL_WAVE_RIPPLE" ;
    ns1:section "W.7.6" .

ns1:F_W.7.7_DIODE_POWER a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "P = V_F·I·(1−D) + f·V_R·I·t_rr/2" ;
    ns1:name "F_W.7.7_DIODE_POWER" ;
    ns1:section "W.7.7" .

ns1:F_W.7.8_MOSFET_IV a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "I_D = (1/2)·μ·C_ox·(W/L)·(V_GS−V_th)²·(1+λV_DS)" ;
    ns1:name "F_W.7.8_MOSFET_IV" ;
    ns1:section "W.7.8" .

ns1:F_W.7.9_MOSFET_THRESHOLD a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:name "F_W.7.9_MOSFET_THRESHOLD" ;
    ns1:section "W.7.9" .

ns1:F_W.8.10_MMF a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "MMF = N·I [A·turn]" ;
    ns1:name "F_W.8.10_MMF" ;
    ns1:section "W.8.10" .

ns1:F_W.8.12_CORE_ENERGY a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "W = ½·L·I² = ½·B²/μ ·A·l [J]" ;
    ns1:name "F_W.8.12_CORE_ENERGY" ;
    ns1:section "W.8.12" .

ns1:F_W.8.13_STEINMETZ a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "P_core = k_h·f^α·B^β，α≈1.4~1.7，β≈2~3" ;
    ns1:name "F_W.8.13_STEINMETZ" ;
    ns1:section "W.8.13" .

ns1:F_W.8.14_EDDY_CURRENT a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "P_eddy = k_e·f²·B²·A²/d（d=片厚）" ;
    ns1:name "F_W.8.14_EDDY_CURRENT" ;
    ns1:section "W.8.14" .

ns1:F_W.8.15_HYSTERESIS_LOSS a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "P_hyst = ∮H·dB·f·V_core（B-H 曲线面积）" ;
    ns1:name "F_W.8.15_HYSTERESIS_LOSS" ;
    ns1:section "W.8.15" .

ns1:F_W.8.16_COPPER_LOSS a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "P_cu = I_rms²·R_dc" ;
    ns1:name "F_W.8.16_COPPER_LOSS" ;
    ns1:section "W.8.16" .

ns1:F_W.8.17_AC_RESISTANCE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "交流电阻（趋肤/邻近）" ;
    ns1:name "F_W.8.17_AC_RESISTANCE" ;
    ns1:section "W.8.17" .

ns1:F_W.8.18_SKIN_DEPTH a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "δ = √(2ρ/(ωμ)) [m]" ;
    ns1:name "F_W.8.18_SKIN_DEPTH" ;
    ns1:section "W.8.18" .

ns1:F_W.8.19_PROXIMITY a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "邻近导体改变有效电感/电阻" ;
    ns1:name "F_W.8.19_PROXIMITY" ;
    ns1:section "W.8.19" .

ns1:F_W.8.1_TURNS_RATIO a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "n = N_p/N_s；V_s/V_p = N_s/N_p（理想）" ;
    ns1:name "F_W.8.1_TURNS_RATIO" ;
    ns1:section "W.8.1" .

ns1:F_W.8.20_LITZ a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "多股细线减小趋肤/邻近效应" ;
    ns1:name "F_W.8.20_LITZ" ;
    ns1:section "W.8.20" .

ns1:F_W.8.21_INDUCTOR_DCR a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "R_dcr = ℜ·l_wire/A_wire" ;
    ns1:name "F_W.8.21_INDUCTOR_DCR" ;
    ns1:section "W.8.21" .

ns1:F_W.8.22_CORE_LOSS_TOTAL a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "P_core,total = P_hyst + P_eddy + P_excess" ;
    ns1:name "F_W.8.22_CORE_LOSS_TOTAL" ;
    ns1:section "W.8.22" .

ns1:F_W.8.2_FLUX_DENSITY a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "B = Φ/A_core，Φ = N·I·L_m/N 或 B = V·t_turn_on/(N·A_core)" ;
    ns1:name "F_W.8.2_FLUX_DENSITY" ;
    ns1:section "W.8.2" .

ns1:F_W.8.3_SATURATION a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "B ≥ B_sat 时电感量崩塌、电流飙升" ;
    ns1:name "F_W.8.3_SATURATION" ;
    ns1:section "W.8.3" .

ns1:F_W.8.4_FLUX_WALK a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "ΔB_max = V·D·T_s/(N·A_core)（< B_sat 为安全）" ;
    ns1:name "F_W.8.4_FLUX_WALK" ;
    ns1:section "W.8.4" .

ns1:F_W.8.5_FLUX_RESET a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "单绕组正激需 D_max ≤ 0.5；否则加复位绕组" ;
    ns1:name "F_W.8.5_FLUX_RESET" ;
    ns1:section "W.8.5" .

ns1:F_W.8.6_COUPLING a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "k = M/√(L₁L₂)，M = k√(L₁L₂)" ;
    ns1:name "F_W.8.6_COUPLING" ;
    ns1:section "W.8.6" .

ns1:F_W.8.7_LEAKAGE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "L_lk = L_measured(短路) − L_mutual" ;
    ns1:name "F_W.8.7_LEAKAGE" ;
    ns1:section "W.8.7" .

ns1:F_W.8.8_AMPERE_TURNS a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "N₁I₁ + N₂I₂ = 0（理想磁芯磁导无穷大）" ;
    ns1:name "F_W.8.8_AMPERE_TURNS" ;
    ns1:section "W.8.8" .

ns1:F_W.8.9_MAGNETIC_OHMS a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "Φ = MMF/ℜ，ℜ = l_core/(μ·A_core)" ;
    ns1:name "F_W.8.9_MAGNETIC_OHMS" ;
    ns1:section "W.8.9" .

ns1:F_W.9.10_EFFECTIVE_BITS_ISO a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:name "F_W.9.10_EFFECTIVE_BITS_ISO" ;
    ns1:section "W.9.10" .

ns1:F_W.9.11_NOISE_FIGURE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "F = SNR_in/SNR_out（线性）；NF_dB = 10log₁₀F" ;
    ns1:name "F_W.9.11_NOISE_FIGURE" ;
    ns1:section "W.9.11" .

ns1:F_W.9.12_THERMAL_NOISE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "v_n = √(4kTRB) [V/√Hz]" ;
    ns1:name "F_W.9.12_THERMAL_NOISE" ;
    ns1:section "W.9.12" .

ns1:F_W.9.13_JOHNSON_NOISE_IL a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "i_n = √(4kTB/R) [A/√Hz]" ;
    ns1:name "F_W.9.13_JOHNSON_NOISE_IL" ;
    ns1:section "W.9.13" .

ns1:F_W.9.14_SHOT_NOISE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "i_n = √(2qI) [A/√Hz]" ;
    ns1:name "F_W.9.14_SHOT_NOISE" ;
    ns1:section "W.9.14" .

ns1:F_W.9.15_FLICKER_NOISE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "n ∝ 1/f（低频段）" ;
    ns1:name "F_W.9.15_FLICKER_NOISE" ;
    ns1:section "W.9.15" .

ns1:F_W.9.16_AVG_NOISE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "SNR_improve = 10·log₁₀(n) [dB]" ;
    ns1:name "F_W.9.16_AVG_NOISE" ;
    ns1:section "W.9.16" .

ns1:F_W.9.17_RMS_VS_PP a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "见 F_J.5_RIPPLE_RMS_TRI/SQ/SIN" ;
    ns1:name "F_W.9.17_RMS_VS_PP" ;
    ns1:section "W.9.17" .

ns1:F_W.9.18_ENBW a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "ENBW = ∫" ;
    ns1:name "F_W.9.18_ENBW" ;
    ns1:section "W.9.18" .

ns1:F_W.9.2_THD_N a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "THD+N = √(Σ_{n≥2} X_n² + N²)/X_1" ;
    ns1:name "F_W.9.2_THD_N" ;
    ns1:section "W.9.2" .

ns1:F_W.9.3_SINAD a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "SINAD = 10·log₁₀(P_signal/P_noise+distortion)" ;
    ns1:name "F_W.9.3_SINAD" ;
    ns1:section "W.9.3" .

ns1:F_W.9.4_SNR a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "SNR = 10·log₁₀(P_signal/P_noise)" ;
    ns1:name "F_W.9.4_SNR" ;
    ns1:section "W.9.4" .

ns1:F_W.9.5_SNR_QUANTIZATION a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "SNR = 6.02·N + 1.76 [dB]" ;
    ns1:name "F_W.9.5_SNR_QUANTIZATION" ;
    ns1:section "W.9.5" .

ns1:F_W.9.6_ENOB a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "ENOB = (SINAD − 1.76)/6.02 [bit]" ;
    ns1:name "F_W.9.6_ENOB" ;
    ns1:section "W.9.6" .

ns1:F_W.9.7_QUANT_NOISE_POWER a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "P_q = q²/12（均匀量化假设）" ;
    ns1:name "F_W.9.7_QUANT_NOISE_POWER" ;
    ns1:section "W.9.7" .

ns1:F_W.9.8_INL a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "INL = max\\" ;
    ns1:name "F_W.9.8_INL" ;
    ns1:section "W.9.8" .

ns1:F_W.9.9_DNL a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "DNL(k) = (ΔV(k) − q)/q" ;
    ns1:name "F_W.9.9_DNL" ;
    ns1:section "W.9.9" .

