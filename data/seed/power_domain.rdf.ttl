    ns1:name "帕塞瓦尔本征" .

ns1:A-12 a ns1:Axiom ;
    ns1:applies_to_formula ns1:F_N.2_LOSS_BUDGET ;
    ns1:authority_kind "unverified" ;
    ns1:has_theorem ns1:thm%3A%3AT13 ;
    ns1:label "第二定律" ;
    ns1:name "第二定律" .

ns1:A-13 a ns1:Axiom ;
    ns1:authority_kind "unverified" ;
    ns1:has_theorem ns1:thm%3A%3AT18 ;
    ns1:label "集总参数" ;
    ns1:name "集总参数" .

ns1:A-14 a ns1:Axiom ;
    ns1:authority_kind "unverified" ;
    ns1:has_theorem ns1:thm%3A%3AT3 ;
    ns1:label "周期稳态" ;
    ns1:name "周期稳态" .

ns1:A-15 a ns1:Axiom ;
    ns1:applies_to_formula ns1:F_K.6_FILTER_CRITERION ;
    ns1:authority_kind "unverified" ;
    ns1:has_theorem ns1:thm%3A%3AT21,
        ns1:thm%3A%3AT25 ;
    ns1:label "因果无源" ;
    ns1:name "因果无源" .

ns1:A-2 a ns1:Axiom ;
    ns1:authority_kind "unverified" ;
    ns1:has_theorem ns1:thm%3A%3AT3,
        ns1:thm%3A%3AT4 ;
    ns1:label "KVL" ;
    ns1:name "KVL" .

ns1:A-3 a ns1:Axiom ;
    ns1:authority_kind "unverified" ;
    ns1:has_theorem ns1:thm%3A%3AT7 ;
    ns1:label "能量守恒" ;
    ns1:name "能量守恒" .

ns1:A-4 a ns1:Axiom ;
    ns1:applies_to_formula ns1:F_J.3_INDUCTOR_RIPPLE,
        ns1:F_J.4_OUTPUT_RIPPLE ;
    ns1:authority_kind "unverified" ;
    ns1:has_theorem ns1:thm%3A%3AT3 ;
    ns1:label "电感伏秒" ;
    ns1:name "电感伏秒" .

ns1:A-5 a ns1:Axiom ;
    ns1:applies_to_formula ns1:F_J.4_OUTPUT_RIPPLE ;
    ns1:authority_kind "unverified" ;
    ns1:has_theorem ns1:thm%3A%3AT23,
        ns1:thm%3A%3AT3 ;
    ns1:label "电容电荷" ;
    ns1:name "电容电荷" .

ns1:A-6 a ns1:Axiom ;
    ns1:authority_kind "unverified" ;
    ns1:has_theorem ns1:thm%3A%3AT2 ;
    ns1:label "对偶" ;
    ns1:name "对偶" .

ns1:A-7 a ns1:Axiom ;
    ns1:applies_to_formula ns1:F_K.3_PHASE_MARGIN ;
    ns1:authority_kind "unverified" ;
    ns1:has_theorem ns1:thm%3A%3AT20,
        ns1:thm%3A%3AT21 ;
    ns1:label "唯一性" ;
    ns1:name "唯一性" .

ns1:A-8 a ns1:Axiom ;
    ns1:applies_to_formula ns1:F_W.9.1_THD ;
    ns1:authority_kind "unverified" ;
    ns1:has_theorem ns1:thm%3A%3AT12 ;
    ns1:label "傅里叶" ;
    ns1:name "傅里叶" .

ns1:A-9 a ns1:Axiom ;
    ns1:applies_to_formula ns1:F_M.1_SAMPLING ;
    ns1:authority_kind "unverified" ;
    ns1:has_theorem ns1:thm%3A%3AT19 ;
    ns1:label "采样定理" ;
    ns1:name "采样定理" .

