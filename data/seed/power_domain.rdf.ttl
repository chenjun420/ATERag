ns1:F_W.6.7_SETUP_TIME a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "t_su ≥ t_(max clk→Q) + t_logic − t_(hold)+t_skew" ;
    ns1:name "F_W.6.7_SETUP_TIME" ;
    ns1:section "W.6.7" .

ns1:F_W.6.8_HOLD_TIME a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "t_h ≥ t_(min clk→Q) + t_skew − t_hold,ff" ;
    ns1:name "F_W.6.8_HOLD_TIME" ;
