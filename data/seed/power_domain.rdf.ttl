    ns1:domain "M" ;
    ns1:expr "R_EOL ∈ {1k, 2k, 4.7k, 10k} Ω，I_sup = 1~10 mA" ;
    ns1:name "F_M.2.9_EOL_RESISTOR" ;
    ns1:section "M.2.9" .

ns1:F_M.2_DEBOUNCE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "M" ;
    ns1:expr "t_debounce ≥ 3~5 · τ_noise" ;
    ns1:name "F_M.2_DEBOUNCE" ;
    ns1:section "M.2" .

ns1:F_M.2_SOE_RESOLUTION a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "M" ;
    ns1:expr "t_resolution ≤ 1 ms" ;
    ns1:name "F_M.2_SOE_RESOLUTION" ;
    ns1:section "M.2" .

ns1:F_M.2_TIME_SYNC a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "M" ;
    ns1:expr "t_sync_error ≤ 1 ms" ;
    ns1:name "F_M.2_TIME_SYNC" ;
    ns1:section "M.2" .

ns1:F_M.3.1_RETRY_POLICY a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "M" ;
    ns1:name "F_M.3.1_RETRY_POLICY" ;
    ns1:section "M.3.1" .

ns1:F_M.3.2_WDT_FEASIBILITY a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "M" ;
    ns1:expr "t_max,exec < t_safe（可行域非空）" ;
    ns1:name "F_M.3.2_WDT_FEASIBILITY" ;
    ns1:section "M.3.2" .

ns1:F_M.3.3_WINDOW_WDT a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "M" ;
    ns1:expr "t_win,min < t_exec < t_win,max" ;
    ns1:name "F_M.3.3_WINDOW_WDT" ;
    ns1:section "M.3.3" .

ns1:F_M.3.4_CRC8_PEC a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "M" ;
    ns1:name "F_M.3.4_CRC8_PEC" ;
    ns1:section "M.3.4" .

ns1:F_M.3.5_READBACK_VERIFY a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "M" ;
    ns1:expr "v_readback == v_written 否则重试/报警" ;
    ns1:name "F_M.3.5_READBACK_VERIFY" ;
    ns1:section "M.3.5" .

ns1:F_M.3_COMM_TIMEOUT a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "M" ;
    ns1:expr "t_timeout > N·t_heartbeat + t_proc" ;
    ns1:name "F_M.3_COMM_TIMEOUT" ;
    ns1:section "M.3" .

ns1:F_M.3_WATCHDOG a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "M" ;
    ns1:expr "t_wdt < t_safe 且 t_wdt > t_max,exec" ;
    ns1:name "F_M.3_WATCHDOG" ;
    ns1:section "M.3" .

ns1:F_M.5_CLOCK_JITTER_SNR a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "M" ;
    ns1:expr "SNR_jitter = −20·log₁₀(2π·f·σ_t)" ;
    ns1:name "F_M.5_CLOCK_JITTER_SNR" ;
    ns1:section "M.5" .

ns1:F_N.1.10_FAN_MATCH a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "N" ;
    ns1:expr "工作点 = 风扇静压曲线 ∩ 散热器压降曲线" ;
    ns1:name "F_N.1.10_FAN_MATCH" ;
    ns1:section "N.1.10" .

ns1:F_N.1.11_RADIATION a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[W]" ;
    ns1:domain "N" ;
    ns1:expr "P = ε·σ·A·(T₁⁴ − T₂⁴)，σ = 5.67e-8 W/(m²·K⁴)" ;
    ns1:name "F_N.1.11_RADIATION" ;
    ns1:section "N.1.11" .

ns1:F_N.1.1_THERMAL_RESISTANCE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[K/W]" ;
    ns1:domain "N" ;
    ns1:expr "R_θ = ΔT/P" ;
    ns1:name "F_N.1.1_THERMAL_RESISTANCE" ;
    ns1:section "N.1.1" .

ns1:F_N.1.2_SINK_RESISTANCE_MAX a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[K/W]" ;
    ns1:domain "N" ;
    ns1:expr "R_θsa ≤ (T_j,max − T_a)/P − R_θjc − R_θcs" ;
    ns1:name "F_N.1.2_SINK_RESISTANCE_MAX" ;
    ns1:section "N.1.2" .

ns1:F_N.1.3_THERMAL_SERIES_PARALLEL a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[K/W]" ;
    ns1:domain "N" ;
    ns1:expr "串联求和；并联 1/R_θ = Σ1/R_θi" ;
    ns1:name "F_N.1.3_THERMAL_SERIES_PARALLEL" ;
    ns1:section "N.1.3" .

ns1:F_N.1.4_THERMAL_TRANSIENT a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[W]" ;
    ns1:domain "N" ;
    ns1:expr "C_th·dT/dt = P − (T−T_a)/R_θ" ;
    ns1:name "F_N.1.4_THERMAL_TRANSIENT" ;
    ns1:section "N.1.4" .

ns1:F_N.1.5_THERMAL_TAU a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[s]" ;
    ns1:domain "N" ;
    ns1:expr "τ_th = R_θ·C_th" ;
    ns1:name "F_N.1.5_THERMAL_TAU" ;
    ns1:section "N.1.5" .

ns1:F_N.1.6_THERMAL_SETTLE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[K]" ;
    ns1:domain "N" ;
    ns1:expr "T(t) − T_a = P·R_θ(1 − e^{−t/τ_th})" ;
    ns1:name "F_N.1.6_THERMAL_SETTLE" ;
    ns1:section "N.1.6" .

ns1:F_N.1.7_SOAK_TIME a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[s]" ;
    ns1:domain "N" ;
    ns1:expr "t_驻留 ≥ 3~5 · τ_th" ;
    ns1:name "F_N.1.7_SOAK_TIME" ;
    ns1:section "N.1.7" .

ns1:F_N.1.8_CONVECTION_H a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "N" ;
    ns1:expr "h = Nu·k/L，Nu = f(Gr·Pr) 或 f(Re·Pr)" ;
    ns1:name "F_N.1.8_CONVECTION_H" ;
    ns1:section "N.1.8" .

ns1:F_N.1.9_CONDUCTION_R a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "N" ;
    ns1:expr "R_θ = L/(k·A)" ;
    ns1:name "F_N.1.9_CONDUCTION_R" ;
    ns1:section "N.1.9" .

ns1:F_N.1_THERMAL_NETWORK a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[K]" ;
    ns1:domain "N" ;
    ns1:expr "T_j = T_a + P·(R_θjc + R_θcs + R_θsa)" ;
    ns1:name "F_N.1_THERMAL_NETWORK" ;
    ns1:section "N.1" .

ns1:F_N.2.1_THERMAL_EFFICIENCY_LIMIT a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "N" ;
    ns1:expr "η_max = P_out/(P_out + P_loss,max)" ;
    ns1:name "F_N.2.1_THERMAL_EFFICIENCY_LIMIT" ;
    ns1:section "N.2.1" .

ns1:F_N.3.1_MLCC_DC_BIAS a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "N" ;
    ns1:expr "C_eff = C_nom·k(V_DC)，k 取自厂商曲线" ;
    ns1:name "F_N.3.1_MLCC_DC_BIAS" ;
    ns1:section "N.3.1" .

ns1:F_N.3_DERATING a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "N" ;
    ns1:expr "S = 实际应力/额定应力 ≤ S_max" ;
    ns1:name "F_N.3_DERATING" ;
    ns1:section "N.3" .

ns1:F_N.4.10_REDUNDANCY_NO_MTBF_GAIN a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "N" ;
    ns1:name "F_N.4.10_REDUNDANCY_NO_MTBF_GAIN" ;
    ns1:section "N.4.10" .

ns1:F_N.4.1_EXPONENTIAL_R a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "无量纲" ;
    ns1:domain "N" ;
    ns1:expr "R(t) = e^{−λt} = e^{−t/MTTF}" ;
    ns1:name "F_N.4.1_EXPONENTIAL_R" ;
    ns1:section "N.4.1" .

ns1:F_N.4.2_MTBF a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[T]" ;
    ns1:domain "N" ;
    ns1:expr "MTTF = 1/λ" ;
    ns1:name "F_N.4.2_MTBF" ;
    ns1:section "N.4.2" .

ns1:F_N.4.3_MEDIAN_LIFE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[T]" ;
    ns1:domain "N" ;
    ns1:expr "t₅₀ = ln(2)·MTTF = 0.693·MTTF" ;
    ns1:name "F_N.4.3_MEDIAN_LIFE" ;
    ns1:section "N.4.3" .

ns1:F_N.4.4_PART_STRESS_MODEL a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[T⁻¹]" ;
    ns1:domain "N" ;
    ns1:expr "λp = λb·πE·πQ·πT·πS·πU·πC" ;
    ns1:name "F_N.4.4_PART_STRESS_MODEL" ;
    ns1:section "N.4.4" .

ns1:F_N.4.5_ARRHENIUS a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "无量纲" ;
    ns1:domain "N" ;
    ns1:expr "πT = exp[(E_a/k_B)(1/T_use − 1/T_stress)]，k_B = 8.63e-5 eV/K" ;
    ns1:name "F_N.4.5_ARRHENIUS" ;
    ns1:section "N.4.5" .

ns1:F_N.4.6_TEMP_DOUBLE_RULE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "无量纲比值" ;
    ns1:domain "N" ;
    ns1:expr "L₂ = L₁·2^((T₁−T₂)/10)（经验）" ;
    ns1:name "F_N.4.6_TEMP_DOUBLE_RULE" ;
    ns1:section "N.4.6" .

ns1:F_N.4.7_COFFIN_MANSON a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "N" ;
    ns1:expr "AF = (ΔT_use/ΔT_stress)^m，m = 2~6" ;
    ns1:name "F_N.4.7_COFFIN_MANSON" ;
    ns1:section "N.4.7" .

ns1:F_N.4.8_SERIES_SYSTEM a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "N" ;
    ns1:expr "λ_sys = Σλ_i，MTBF = 1/λ_sys" ;
    ns1:name "F_N.4.8_SERIES_SYSTEM" ;
    ns1:section "N.4.8" .

ns1:F_N.4.9_PARALLEL_SYSTEM a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "N" ;
    ns1:expr "R_sys = 1 − Π(1−R_i)" ;
    ns1:name "F_N.4.9_PARALLEL_SYSTEM" ;
    ns1:section "N.4.9" .

ns1:F_N.5.1_CAP_LIFE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "N" ;
    ns1:expr "L = L₀·2^((T_rated−T_actual)/10)·(V_rated/V_actual)^k" ;
    ns1:name "F_N.5.1_CAP_LIFE" ;
    ns1:section "N.5.1" .

ns1:F_N.5.2_CAP_END_OF_LIFE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "N" ;
    ns1:expr "ESR ≥ 2·ESR₀ 或 C ≤ 0.8·C₀" ;
    ns1:name "F_N.5.2_CAP_END_OF_LIFE" ;
    ns1:section "N.5.2" .

ns1:F_N.5.3_CAP_RIPPLE_HEATING a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "N" ;
    ns1:expr "P = I_ripple,rms²·ESR，ΔT = P·R_θ" ;
    ns1:name "F_N.5.3_CAP_RIPPLE_HEATING" ;
    ns1:section "N.5.3" .

ns1:F_N.6.1_BATHTUB_CURVE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "N" ;
    ns1:name "F_N.6.1_BATHTUB_CURVE" ;
    ns1:section "N.6.1" .

ns1:F_N.6.2_WEIBULL a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "N" ;
    ns1:expr "R(t) = exp(−(t/η)^β)" ;
    ns1:name "F_N.6.2_WEIBULL" ;
    ns1:section "N.6.2" .

ns1:F_N.7.1_FMEDA_PROCESS a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "N" ;
    ns1:name "F_N.7.1_FMEDA_PROCESS" ;
    ns1:section "N.7.1" .

ns1:F_N.7.2_SIL_MTBF_DISTINCT a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "N" ;
    ns1:name "F_N.7.2_SIL_MTBF_DISTINCT" ;
    ns1:section "N.7.2" .

ns1:F_O.2.1_BACKWARD_EULER a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "O" ;
    ns1:expr "s → (1−z⁻¹)/T_s" ;
    ns1:name "F_O.2.1_BACKWARD_EULER" ;
    ns1:section "O.2.1" .

ns1:F_O.2.2_BILINEAR a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "O" ;
    ns1:expr "s → (2/T_s)·(1−z⁻¹)/(1+z⁻¹)" ;
    ns1:name "F_O.2.2_BILINEAR" ;
    ns1:section "O.2.2" .

ns1:F_O.2.3_PREWARP a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "O" ;
    ns1:expr "ω_d = 2·arctan(ω_c·T_s/2)" ;
    ns1:name "F_O.2.3_PREWARP" ;
    ns1:section "O.2.3" .

ns1:F_O.2.4_ZOH_DISCRETIZE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "O" ;
    ns1:expr "A_d = e^{A·T_s}，B_d = ∫₀^{T_s}e^{Aτ}dτ·B" ;
    ns1:name "F_O.2.4_ZOH_DISCRETIZE" ;
    ns1:section "O.2.4" .

ns1:F_O.3.1_PI_INCREMENTAL a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "O" ;
    ns1:expr "Δu[k] = K_p(e[k]−e[k−1]) + K_i·T_s·e[k]" ;
    ns1:name "F_O.3.1_PI_INCREMENTAL" ;
    ns1:section "O.3.1" .

ns1:F_O.3.2_PID_INCREMENTAL a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "O" ;
    ns1:expr "Δu[k] = K_p·Δe + K_i·T_s·e[k] + (K_d/T_s)·Δ²e" ;
    ns1:name "F_O.3.2_PID_INCREMENTAL" ;
    ns1:section "O.3.2" .

ns1:F_O.3.3_FIRMWARE_COEFF a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "O" ;
    ns1:expr "u[k] = b₀e[k]+b₁e[k−1]+b₂e[k−2]+a₁y[k−1]+a₂y[k−2]" ;
    ns1:name "F_O.3.3_FIRMWARE_COEFF" ;
    ns1:section "O.3.3" .

ns1:F_O.3.4_FIXED_POINT_Q a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "O" ;
    ns1:expr "q = round(c·2^F)，误差 ≤ 2^(−F−1)" ;
    ns1:name "F_O.3.4_FIXED_POINT_Q" ;
    ns1:section "O.3.4" .

ns1:F_O.4.1_DIGITAL_COMPENSATOR a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "O" ;
    ns1:expr "G_c(z) = (b₀+b₁z⁻¹+b₂z⁻²)/(1+a₁z⁻¹+a₂z⁻²)" ;
    ns1:name "F_O.4.1_DIGITAL_COMPENSATOR" ;
    ns1:section "O.4.1" .

ns1:F_O.4.2_DIFF_EQ a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "O" ;
    ns1:expr "y[k] = Σb_i x[k−i] − Σa_i y[k−i]" ;
    ns1:name "F_O.4.2_DIFF_EQ" ;
    ns1:section "O.4.2" .

ns1:F_O.4.3_JURY_2ND_ORDER a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "O" ;
    ns1:expr "<1 ∧ (1+a₁+a₂)>0 ∧ (1−a₁+a₂)>0" ;
    ns1:name "F_O.4.3_JURY_2ND_ORDER" ;
    ns1:section "O.4.3" .

ns1:F_O.5.1_IIR_LOWPASS a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "O" ;
    ns1:expr "y[k] = y[k−1]+α(x[k]−y[k−1])，τ_d = T_s/α" ;
    ns1:name "F_O.5.1_IIR_LOWPASS" ;
    ns1:section "O.5.1" .

ns1:F_O.5.2_MOVING_AVERAGE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "O" ;
    ns1:expr "y[k] = (1/N)Σx[k−i]，H(0)=1，延迟 (N−1)T_s/2" ;
    ns1:name "F_O.5.2_MOVING_AVERAGE" ;
    ns1:section "O.5.2" .

ns1:F_O.5.3_MEDIAN a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "O" ;
    ns1:expr "y[k] = median(x[k−N+1..k])，无拖尾" ;
    ns1:name "F_O.5.3_MEDIAN" ;
    ns1:section "O.5.3" .

ns1:F_O.5.4_NOTCH a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "O" ;
    ns1:expr "H_notch(z) = (1−2cosω₀z⁻¹+z⁻²)/(1−2r cosω₀z⁻¹+r²z⁻²)" ;
    ns1:name "F_O.5.4_NOTCH" ;
    ns1:section "O.5.4" .

ns1:F_O.6.1_PWM_RESOLUTION a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "O" ;
    ns1:expr "ΔD_min = 1/2^N_pwm" ;
    ns1:name "F_O.6.1_PWM_RESOLUTION" ;
    ns1:section "O.6.1" .

ns1:F_O.6.2_DEADBAND_COMP a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "O" ;
    ns1:expr "D_comp = t_dead/T_s（单管），t_dead/(2T_s)（双管对称）" ;
    ns1:name "F_O.6.2_DEADBAND_COMP" ;
    ns1:section "O.6.2" .

ns1:F_O.7.1_DSIGMA_NTF a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "O" ;
    ns1:expr "NTF(z) = (1 − z⁻¹)^L" ;
    ns1:name "F_O.7.1_DSIGMA_NTF" ;
    ns1:section "O.7.1" .

ns1:F_O.7.2_OVERSAMPLING_GAIN a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "O" ;
    ns1:expr "ENOB_gain = 0.5·log₂(OSR)" ;
    ns1:name "F_O.7.2_OVERSAMPLING_GAIN" ;
    ns1:section "O.7.2" .

ns1:F_O.9.1_Z_TO_S_MAP a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "O" ;
    ns1:expr "s = (2/T_s)·(1−z⁻¹)/(1+z⁻¹)（双线性反变换）" ;
    ns1:name "F_O.9.1_Z_TO_S_MAP" ;
    ns1:section "O.9.1" .

ns1:F_O.9.2_DISCRETE_PM_GM a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "O" ;
    ns1:expr "离散域 PM/GM（定义同 F_K.3）" ;
    ns1:name "F_O.9.2_DISCRETE_PM_GM" ;
    ns1:section "O.9.2" .

ns1:F_P.1.1_RINGING_FREQ a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[Hz]" ;
    ns1:domain "P" ;
