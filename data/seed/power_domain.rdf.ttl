ns1:F_W.6.9_CLOCK_SKEW a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "t_skew = t_(late max) − t_(early min)" ;
    ns1:name "F_W.6.9_CLOCK_SKEW" ;
    ns1:section "W.6.9" .

ns1:F_W.7.10_RDS_ON_TEMP a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "R_DS(on,T) = R_DS(on,25)·(1+α(T−25))，α ≈ 0.0035/℃（硅）" ;
    ns1:name "F_W.7.10_RDS_ON_TEMP" ;
    ns1:section "W.7.10" .

ns1:F_W.7.11_MOSFET_COSS a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "C_oss = C_GD + C_DS（非线性，随 V_DS 变化）" ;
    ns1:name "F_W.7.11_MOSFET_COSS" ;
    ns1:section "W.7.11" .

ns1:F_W.7.12_MILLER_EFFECT a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "C_Miller = C_GD·(1+A_vds)；A_vds ≈ g_m·(R_DS‖R_load)" ;
    ns1:name "F_W.7.12_MILLER_EFFECT" ;
    ns1:section "W.7.12" .

ns1:F_W.7.13_GATE_CHARGE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "Q_g = Q_gs + Q_gd + Q_ds；I_g(avg) = Q_g/t_sw" ;
