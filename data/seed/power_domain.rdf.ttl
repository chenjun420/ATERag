    ns1:name "环境温度参考" ;
    ns1:zh "环境温度参考" .

ns1:COND_TEMP_REF_Tc a ns1:PowerConcept ;
    ns1:aliases "Tc, 壳温" ;
    ns1:authority_kind "unverified" ;
    ns1:en "case temperature reference" ;
    ns1:name "壳温参考" ;
    ns1:zh "壳温参考" .

ns1:COND_TEMP_REF_Tj a ns1:PowerConcept ;
    ns1:aliases "Tj, 结温" ;
    ns1:authority_kind "unverified" ;
    ns1:en "junction temperature reference" ;
    ns1:name "结温参考" ;
    ns1:zh "结温参考" .

ns1:COND_VIN_MAX a ns1:PowerConcept ;
    ns1:aliases "输入上限" ;
    ns1:authority_kind "unverified" ;
    ns1:en "maximum input voltage" ;
    ns1:name "最大输入电压" ;
    ns1:zh "最大输入电压" .

ns1:COND_VIN_MIN a ns1:PowerConcept ;
    ns1:aliases "输入下限" ;
    ns1:authority_kind "unverified" ;
    ns1:en "minimum input voltage" ;
    ns1:name "最小输入电压" ;
    ns1:zh "最小输入电压" .

ns1:COND_VIN_NOM a ns1:PowerConcept ;
    ns1:aliases "额定输入" ;
    ns1:authority_kind "industry" ;
    ns1:authority_ref "GB/T 2900.1 电工术语; IEC 60050-151" ;
    ns1:en "nominal input voltage" ;
    ns1:name "标称输入电压" ;
    ns1:original_zh "额定输入电压" ;
    ns1:zh "标称输入电压" .

ns1:CONFORMAL_COATING a ns1:PowerConcept ;
    ns1:aliases "三防" ;
    ns1:authority_kind "standard" ;
    ns1:authority_ref "IEC 60664-1 / IPC-2221B 涂覆(coating)对爬电距离与污染等级的影响" ;
    ns1:en "conformal coating" ;
    ns1:name "三防处理" ;
    ns1:zh "三防涂覆" ;
    ns1:zh_declared "三防处理" .

ns1:CURRENT_SHARING a ns1:PowerConcept ;
    ns1:aliases "均流度" ;
    ns1:authority_kind "standard" ;
    ns1:authority_ref "3.60 规定负载分配的并联工作(parallel operation with specified load sharing)" ;
    ns1:en "current sharing" ;
    ns1:has_unit_kind ns1:qudt%3ADimensionlessRatio ;
    ns1:name "负载均流度" ;
    ns1:qudt_ref "DimensionlessRatio" ;
    ns1:zh "均流" ;
    ns1:zh_declared "负载均流度" .

ns1:DERATING a ns1:PowerConcept ;
    ns1:aliases "降额准则" ;
    ns1:authority_kind "standard" ;
    ns1:authority_ref "GB/T 2900.32-1994 2.2.9 热降额因数(thermal derating factor)" ;
    ns1:en "derating" ;
    ns1:name "降额" ;
    ns1:zh "降额" .

ns1:DIP_IMMUNITY a ns1:PowerConcept ;
    ns1:aliases "电压跌落, DIP" ;
    ns1:authority_kind "standard" ;
    ns1:authority_ref "GB/T 17626.11-2023" ;
    ns1:defined_by ns1:std%3A%3AGB%2FT%2017626.11-2023 ;
    ns1:en "voltage dip immunity" ;
    ns1:name "电压跌落抗扰度" ;
    ns1:zh "电压暂降、短时中断和电压变化抗扰度" ;
    ns1:zh_declared "电压跌落抗扰度" .

ns1:DYNAMIC_OVERSHOOT a ns1:PowerConcept ;
    ns1:aliases "负载瞬态过冲, 瞬态过冲" ;
    ns1:authority_kind "standard" ;
    ns1:authority_ref "3.42 过冲幅度(overshoot amplitude)" ;
    ns1:en "dynamic response overshoot" ;
    ns1:has_unit_kind ns1:qudt%3ADimensionlessRatio ;
    ns1:name "动态响应过冲" ;
    ns1:qudt_ref "DimensionlessRatio" ;
    ns1:zh "过冲幅度" ;
    ns1:zh_declared "动态响应过冲" .

ns1:DYNAMIC_RESPONSE a ns1:PowerConcept ;
    ns1:aliases "负载瞬态响应, 瞬态恢复" ;
    ns1:authority_kind "standard" ;
    ns1:authority_ref "3.49 瞬态恢复时间(transient recovery time)" ;
    ns1:en "dynamic response recovery time" ;
    ns1:has_unit_kind ns1:qudt%3ATime ;
    ns1:name "动态响应恢复时间" ;
    ns1:qudt_ref "Time" ;
    ns1:zh "瞬态恢复时间" ;
    ns1:zh_declared "动态响应恢复时间" .

ns1:EFFICIENCY a ns1:PowerConcept ;
    ns1:aliases "电源效率, 转换效率" ;
    ns1:authority_kind "unverified" ;
    ns1:en "overall efficiency" ;
    ns1:has_unit_kind ns1:qudt%3ADimensionlessRatio ;
    ns1:name "整机效率" ;
    ns1:qudt_ref "DimensionlessRatio" ;
    ns1:zh "整机效率" .

ns1:EFT_IMMUNITY a ns1:PowerConcept ;
    ns1:aliases "电快速瞬变, EFT/B" ;
    ns1:authority_kind "standard" ;
    ns1:authority_ref "GB/T 17626.4-2018" ;
    ns1:defined_by ns1:std%3A%3AGB%2FT%2017626.4-2018 ;
    ns1:en "EFT immunity" ;
    ns1:name "电快速瞬变抗扰度" ;
    ns1:zh "电快速瞬变脉冲群抗扰度" ;
    ns1:zh_declared "电快速瞬变抗扰度" .

ns1:ESD_IMMUNITY a ns1:PowerConcept ;
    ns1:aliases "静电, ESD" ;
    ns1:authority_kind "standard" ;
    ns1:authority_ref "GB/T 17626.2-2018" ;
    ns1:defined_by ns1:std%3A%3AGB%2FT%2017626.2-2018 ;
    ns1:en "ESD immunity" ;
    ns1:name "静电抗扰度" ;
    ns1:zh "静电放电抗扰度" ;
    ns1:zh_declared "静电抗扰度" .

ns1:FAILURE_ISOLATION a ns1:PowerConcept ;
    ns1:aliases "单模块故障隔离" ;
    ns1:authority_kind "unverified" ;
    ns1:en "failure isolation" ;
    ns1:name "失效隔离" ;
    ns1:zh "失效隔离" .

ns1:F_E.10_DERATING a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "无量纲" ;
    ns1:domain "E" ;
    ns1:expr "S = 实际/额定 ≤ S_max" ;
    ns1:name "F_E.10_DERATING" ;
    ns1:section "E.10" .

ns1:F_E.13_AVAILABLE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "无量纲" ;
    ns1:domain "E" ;
    ns1:expr "A = MTTF/(MTTF+MTTR)" ;
    ns1:name "F_E.13_AVAILABLE" ;
    ns1:section "E.13" .

ns1:F_E.18 a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[°],[Hz]" ;
    ns1:domain "E" ;
    ns1:expr "PM≈45°~60°, GM≥10dB, fc≤fsw/10~1/20" ;
    ns1:name "F_E.18" ;
    ns1:section "E.18" .

ns1:F_E.1_OHM_LAW a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[V]" ;
    ns1:domain "E" ;
    ns1:expr "V = I·R" ;
    ns1:name "F_E.1_OHM_LAW" ;
    ns1:section "E.1" .

ns1:F_E.2 a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[W]" ;
    ns1:domain "E" ;
    ns1:expr "P = V·I = I²·R = V²/R" ;
    ns1:name "F_E.2" ;
    ns1:section "E.2" .

ns1:F_E.27_DEBOUNCE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[T]" ;
    ns1:domain "E" ;
    ns1:expr "t_debounce ≥ 3~5·τ_noise" ;
    ns1:name "F_E.27_DEBOUNCE" ;
    ns1:section "E.27" .

ns1:F_E.27_SOE_RESOLUTION a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[T]" ;
    ns1:domain "E" ;
    ns1:expr "t_resolution ≤ 1 ms" ;
    ns1:name "F_E.27_SOE_RESOLUTION" ;
    ns1:section "E.27" .

ns1:F_E.27_TIME_SYNC a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[T]" ;
    ns1:domain "E" ;
    ns1:expr "t_sync_error ≤ 1 ms" ;
    ns1:name "F_E.27_TIME_SYNC" ;
    ns1:section "E.27" .

ns1:F_E.28_QUANTIZATION a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[V]" ;
    ns1:domain "E" ;
    ns1:expr "q = V_FS/2^N, 误差 ≤ q/2" ;
    ns1:name "F_E.28_QUANTIZATION" ;
    ns1:section "E.28" .

ns1:F_E.28_REFRESH_RATE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[Hz]" ;
    ns1:domain "E" ;
    ns1:expr "f_refresh ≥ 规定值" ;
    ns1:name "F_E.28_REFRESH_RATE" ;
    ns1:section "E.28" .

ns1:F_E.28_SAMPLING a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[Hz]" ;
    ns1:domain "E" ;
    ns1:expr "f_s ≥ k·f_max, k=5~10" ;
    ns1:name "F_E.28_SAMPLING" ;
    ns1:section "E.28" .

ns1:F_E.28_TUR a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "无量纲" ;
    ns1:domain "E" ;
    ns1:expr "TUR = tol/(2·U) ≥ 4" ;
    ns1:name "F_E.28_TUR" ;
    ns1:section "E.28" .

ns1:F_E.28_YC_ACCURACY a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[X]" ;
    ns1:domain "E" ;
    ns1:expr "δ = ±(a%·reading + b%·FS)" ;
    ns1:name "F_E.28_YC_ACCURACY" ;
    ns1:section "E.28" .

ns1:F_E.29_COMM_TIMEOUT a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[T]" ;
    ns1:domain "E" ;
    ns1:expr "t_timeout > N·t_heartbeat + t_proc" ;
    ns1:name "F_E.29_COMM_TIMEOUT" ;
    ns1:section "E.29" .

ns1:F_E.29_WATCHDOG a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[T]" ;
    ns1:domain "E" ;
    ns1:expr "t_wdt < t_safe" ;
    ns1:name "F_E.29_WATCHDOG" ;
    ns1:section "E.29" .

ns1:F_E.30_ALARM_MARGIN a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[V]" ;
    ns1:domain "E" ;
    ns1:expr "欠压 U_alarm>U_prot；过压 U_alarm<U_prot" ;
    ns1:name "F_E.30_ALARM_MARGIN" ;
    ns1:section "E.30" .

ns1:F_E.30_COORDINATION a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[T]" ;
    ns1:domain "E" ;
    ns1:expr "T_backup − T_main ≥ CTI" ;
    ns1:name "F_E.30_COORDINATION" ;
    ns1:section "E.30" .

ns1:F_E.30_I2T a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[A²s]" ;
    ns1:domain "E" ;
    ns1:expr "(I²t)_下 ≤ (I²t)_上/K, K∈[1.2,2.0]" ;
    ns1:name "F_E.30_I2T" ;
    ns1:section "E.30" .

ns1:F_E.30_RETURN_RATIO a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "无量纲" ;
    ns1:domain "E" ;
    ns1:expr "K_return = U_rel/U_trip ∈[0.8,0.95]" ;
    ns1:name "F_E.30_RETURN_RATIO" ;
    ns1:section "E.30" .

ns1:F_E.30_TRIP_TIME a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[T]" ;
    ns1:domain "E" ;
    ns1:expr "t_trip ≤ t_damage − t_margin" ;
    ns1:name "F_E.30_TRIP_TIME" ;
    ns1:section "E.30" .

ns1:F_E.3_KCL a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[A]" ;
    ns1:domain "E" ;
    ns1:expr "ΣI_in = ΣI_out" ;
    ns1:name "F_E.3_KCL" ;
    ns1:section "E.3" .

ns1:F_E.4_KVL a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[V]" ;
    ns1:domain "E" ;
    ns1:expr "ΣV = 0" ;
    ns1:name "F_E.4_KVL" ;
    ns1:section "E.4" .

ns1:F_E.9_CLEARANCE_CREEPAGE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[m]" ;
    ns1:domain "E" ;
    ns1:expr "爬电/电气间隙" ;
    ns1:name "F_E.9_CLEARANCE_CREEPAGE" ;
    ns1:section "E.9" .

ns1:F_H.16.1_INSTRUMENT_MATCH a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "H" ;
    ns1:name "F_H.16.1_INSTRUMENT_MATCH" ;
    ns1:section "H.16.1" .

ns1:F_H.16.2_GAP_REPORT a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "H" ;
    ns1:name "F_H.16.2_GAP_REPORT" ;
    ns1:section "H.16.2" .

ns1:F_J.10.1_TRUE_POWER_FACTOR a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "PF = cosφ₁/sqrt(1+THD_I²)" ;
    ns1:name "F_J.10.1_TRUE_POWER_FACTOR" ;
    ns1:section "J.10.1" .

ns1:F_J.10.2_THD a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "THD = sqrt(Σ_{n≥2} X_n²)/X_1" ;
    ns1:name "F_J.10.2_THD" ;
    ns1:section "J.10.2" .

ns1:F_J.10.3_IEC61000_3_2_LIMIT a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:name "F_J.10.3_IEC61000_3_2_LIMIT" ;
    ns1:section "J.10.3" .

ns1:F_J.11.1_INPUT_CURRENT a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[A]" ;
    ns1:domain "J" ;
    ns1:expr "I_in = P_out/(η·PF·V_in)" ;
    ns1:name "F_J.11.1_INPUT_CURRENT" ;
    ns1:section "J.11.1" .

ns1:F_J.11.2_INRUSH_PEAK a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[V]/[Ω] = [A]" ;
    ns1:domain "J" ;
    ns1:expr "I_pk = V_peak/R_s，V_peak = √2·V_rms" ;
    ns1:name "F_J.11.2_INRUSH_PEAK" ;
    ns1:section "J.11.2" .

ns1:F_J.11.3_INRUSH_TAU a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[Ω]·[F] = [s]" ;
    ns1:domain "J" ;
    ns1:expr "τ = R_s·C_in，I(t) = (V_peak/R_s)e^{−t/τ}" ;
    ns1:name "F_J.11.3_INRUSH_TAU" ;
    ns1:section "J.11.3" .

ns1:F_J.11.4_INRUSH_RMS a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "I_rms = (V_peak/R_s)·sqrt(τ/(2·T_hold))" ;
    ns1:name "F_J.11.4_INRUSH_RMS" ;
    ns1:section "J.11.4" .

ns1:F_J.12.1_THERMAL_LIMITED_EFFICIENCY a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "η_max = P_out/(P_out + (T_max−T_a)/R_θ)" ;
    ns1:name "F_J.12.1_THERMAL_LIMITED_EFFICIENCY" ;
    ns1:section "J.12.1" .

ns1:F_J.2.1_BUCK a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[V]" ;
    ns1:domain "J" ;
    ns1:expr "V_out = D · V_in" ;
    ns1:name "F_J.2.1_BUCK" ;
    ns1:section "J.2.1" .

ns1:F_J.2.2_BOOST a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "V_out = V_in / (1 − D)" ;
    ns1:name "F_J.2.2_BOOST" ;
    ns1:section "J.2.2" .

ns1:F_J.2.3_BUCKBOOST a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "V_out = −V_in · D / (1 − D)" ;
    ns1:name "F_J.2.3_BUCKBOOST" ;
    ns1:section "J.2.3" .

ns1:F_J.2.4_CUK a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "V_out = −V_in·D/(1−D)" ;
    ns1:name "F_J.2.4_CUK" ;
    ns1:section "J.2.4" .

ns1:F_J.2.5_ZETA_SEPIC a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "V_out = +V_in·D/(1−D)" ;
    ns1:name "F_J.2.5_ZETA_SEPIC" ;
    ns1:section "J.2.5" .

ns1:F_J.3.2_BUCK_RIPPLE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "ΔI_L = V_in·(1−D)·D/(L·f_sw)" ;
    ns1:name "F_J.3.2_BUCK_RIPPLE" ;
    ns1:section "J.3.2" .

ns1:F_J.3.3_BOOST_RIPPLE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "ΔI_L = V_in·D/(L·f_sw)" ;
    ns1:name "F_J.3.3_BOOST_RIPPLE" ;
    ns1:section "J.3.3" .

ns1:F_J.3.4_INDUCTOR_SIZING a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:name "F_J.3.4_INDUCTOR_SIZING" ;
    ns1:section "J.3.4" .

ns1:F_J.3.5_PEAK_CURRENT a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:name "F_J.3.5_PEAK_CURRENT" ;
    ns1:section "J.3.5" .

ns1:F_J.4.2_ESR_ZERO_FREQ a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[Hz]" ;
    ns1:domain "J" ;
    ns1:expr "ω_z,esr = 1/(ESR·C_out)，f_esr = ω_z,esr/(2π)" ;
    ns1:name "F_J.4.2_ESR_ZERO_FREQ" ;
    ns1:section "J.4.2" .

ns1:F_J.4.3_IMPEDANCE_PEAK a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[Ω]" ;
    ns1:domain "J" ;
    ns1:expr "= sqrt(ESR² + (ω·ESL − 1/(ω·C))²)，ω_peak = 1/sqrt(ESL·C)" ;
    ns1:name "F_J.4.3_IMPEDANCE_PEAK" ;
    ns1:section "J.4.3" .

ns1:F_J.5.1_REFLECTED_VOLTAGE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "V_or = n·(V_out + V_f)" ;
    ns1:name "F_J.5.1_REFLECTED_VOLTAGE" ;
    ns1:section "J.5.1" .

ns1:F_J.5.2_MOSFET_DVSTRESS a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "V_ds,max = V_in,max + V_or + ΔV_spike" ;
    ns1:name "F_J.5.2_MOSFET_DVSTRESS" ;
    ns1:section "J.5.2" .

ns1:F_J.5.2_RIPPLE_RMS_SQ a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "V_rms = V_pp/2" ;
    ns1:name "F_J.5.2_RIPPLE_RMS_SQ" ;
    ns1:section "J.5.2" .

ns1:F_J.5.3_LEAKAGE_ENERGY a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "E_Lk = ½·L_lk·I_pk²" ;
    ns1:name "F_J.5.3_LEAKAGE_ENERGY" ;
    ns1:section "J.5.3" .

ns1:F_J.5.3_RIPPLE_RMS_SIN a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "V_rms = V_pp/(2√2)" ;
    ns1:name "F_J.5.3_RIPPLE_RMS_SIN" ;
    ns1:section "J.5.3" .

ns1:F_J.5.4_RCD_CLAMP_POWER a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "P_clamp = E_Lk·f_sw = ½·L_lk·I_pk²·f_sw" ;
    ns1:name "F_J.5.4_RCD_CLAMP_POWER" ;
    ns1:section "J.5.4" .

ns1:F_J.5.5_FORWARD a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "V_out = D·V_in/n" ;
    ns1:name "F_J.5.5_FORWARD" ;
    ns1:section "J.5.5" .

ns1:F_J.5.6_HALF_FULL_BRIDGE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "V_out = D·V_in（半桥 D_eff = 2D−1）" ;
    ns1:name "F_J.5.6_HALF_FULL_BRIDGE" ;
    ns1:section "J.5.6" .

ns1:F_J.5.7_PUSH_PULL a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "V_out = D·V_in/n" ;
    ns1:name "F_J.5.7_PUSH_PULL" ;
    ns1:section "J.5.7" .

ns1:F_J.5_RIPPLE_RMS_TRI a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "V_rms = V_pp/(2√3)" ;
    ns1:name "F_J.5_RIPPLE_RMS_TRI" ;
    ns1:section "J.5" .

ns1:F_J.6.1_CCM_DCM_BOUNDARY a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "K = 2·L·f_sw/R_load'；K>1 CCM / K<1 DCM" ;
    ns1:name "F_J.6.1_CCM_DCM_BOUNDARY" ;
    ns1:section "J.6.1" .

ns1:F_J.6.2_DCM_PEAK_CURRENT a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "I_pk = sqrt(2·P_out·L·f_sw/(D²·V_in))（Boost）" ;
    ns1:name "F_J.6.2_DCM_PEAK_CURRENT" ;
    ns1:section "J.6.2" .

ns1:F_J.6.4_PFM_BURST a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "P_sw,total = N_burst · (E_on+E_off) · f_burst" ;
    ns1:name "F_J.6.4_PFM_BURST" ;
    ns1:section "J.6.4" .

ns1:F_J.7.1_RESONANT_FREQ a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "f_r = 1/(2π√(L_r·C_r))" ;
    ns1:name "F_J.7.1_RESONANT_FREQ" ;
    ns1:section "J.7.1" .

ns1:F_J.7.2_DEADTIME_MIN a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "t_dead,min = C_oss·V_in/I_comm" ;
    ns1:name "F_J.7.2_DEADTIME_MIN" ;
    ns1:section "J.7.2" .

ns1:F_J.7.3_LLC_FREQ a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "f_sr = 1/(2π√(L_r·C_r))，f_pr = 1/(2π√(L_p·C_r))" ;
    ns1:name "F_J.7.3_LLC_FREQ" ;
    ns1:section "J.7.3" .

ns1:F_J.8.1_SHOOT_THROUGH a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[A]" ;
    ns1:domain "J" ;
    ns1:expr "I_shoot = V_bus/(2·L_par)" ;
    ns1:name "F_J.8.1_SHOOT_THROUGH" ;
    ns1:section "J.8.1" .

ns1:F_J.8.2_RC_SNUBBER_LOSS a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[F]·[V²]·[Hz] = [W]" ;
    ns1:domain "J" ;
    ns1:expr "P = C·ΔV²·f_sw" ;
    ns1:name "F_J.8.2_RC_SNUBBER_LOSS" ;
    ns1:section "J.8.2" .

ns1:F_J.8.3_VDS_SPIKE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:declared_dimension "[A]·[H]·[Hz]/[F] = [V]" ;
    ns1:domain "J" ;
    ns1:expr "ΔV_spike ≈ I_pk·L_lk·f_sw/C_oss" ;
    ns1:name "F_J.8.3_VDS_SPIKE" ;
    ns1:section "J.8.3" .

ns1:F_J.9.1_COND_LOSS a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "P_cond = I_rms²·R_ds(on)·D，I_rms = sqrt(I_L²+ΔI_L²/12)" ;
    ns1:name "F_J.9.1_COND_LOSS" ;
    ns1:section "J.9.1" .

ns1:F_J.9.2_SWITCHING_LOSS a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "P_sw = ½·(E_on+E_off)·f_sw" ;
    ns1:name "F_J.9.2_SWITCHING_LOSS" ;
    ns1:section "J.9.2" .

ns1:F_J.9.3_GATE_DRIVE_LOSS a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "P_gate = C_gate·V_gate²·f_sw" ;
    ns1:name "F_J.9.3_GATE_DRIVE_LOSS" ;
    ns1:section "J.9.3" .

ns1:F_J.9.4_CORE_LOSS a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "P_core = k_h·f^α·B^β（Steinmetz）" ;
    ns1:name "F_J.9.4_CORE_LOSS" ;
    ns1:section "J.9.4" .

ns1:F_J.9.5_SR_CROSSOVER a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "D* = V_F/(V_F + I_o·R_ds(on))" ;
    ns1:name "F_J.9.5_SR_CROSSOVER" ;
    ns1:section "J.9.5" .

ns1:F_J.9.6_TOTAL_LOSS a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "P_loss = Σ P_i（见 J.9.1 清单）" ;
    ns1:name "F_J.9.6_TOTAL_LOSS" ;
    ns1:section "J.9.6" .

ns1:F_J.9.7_EFFICIENCY a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "η = P_out/(P_out + P_loss)" ;
    ns1:name "F_J.9.7_EFFICIENCY" ;
    ns1:section "J.9.7" .

ns1:F_J.9.8_LOSS_BUDGET a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "J" ;
    ns1:expr "P_loss,max = P_out·(1−η_target)/η_target" ;
    ns1:name "F_J.9.8_LOSS_BUDGET" ;
    ns1:section "J.9.8" .

ns1:F_K.1.1_LOOP_GAIN a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "T(s) = G_c(s)·G_p(s)·H(s)/V_M" ;
    ns1:name "F_K.1.1_LOOP_GAIN" ;
    ns1:section "K.1.1" .

ns1:F_K.1.2_SENSITIVITY a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "S(s) = 1/(1+T(s))" ;
    ns1:name "F_K.1.2_SENSITIVITY" ;
    ns1:section "K.1.2" .

ns1:F_K.1.3_BUCK_GVD a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "G_vd(s) = V_in(1+s·R_ESR·C)/(1 + s·(L/R) + s²LC)" ;
    ns1:name "F_K.1.3_BUCK_GVD" ;
    ns1:section "K.1.3" .

ns1:F_K.1.4_RESONANCE_Q a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "ω₀ = 1/sqrt(LC)，Q = R·sqrt(C/L)" ;
    ns1:name "F_K.1.4_RESONANCE_Q" ;
    ns1:section "K.1.4" .

ns1:F_K.2_RHPZ_FREQ a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "f_RHPZ = R_load·(1−D)²/(2π·L)" ;
    ns1:name "F_K.2_RHPZ_FREQ" ;
    ns1:section "K.2" .

ns1:F_K.3.3_SETTLING_TIME a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "t_s ≈ 4/σ（2% 判据）、3/σ（5% 判据）" ;
    ns1:name "F_K.3.3_SETTLING_TIME" ;
    ns1:section "K.3.3" .

ns1:F_K.3.4_OVERSHOOT a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "M_os = exp(−π·σ/ω_d)·100%" ;
    ns1:name "F_K.3.4_OVERSHOOT" ;
    ns1:section "K.3.4" .

ns1:F_K.3.5_MULTI_CROSS_PM a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "PM_eff = min_{f:\\" ;
    ns1:name "F_K.3.5_MULTI_CROSS_PM" ;
    ns1:section "K.3.5" .

ns1:F_K.3.6_SECOND_ORDER_TS a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "t_settle,2% ≈ 4/(ζ·ω_n)" ;
    ns1:name "F_K.3.6_SECOND_ORDER_TS" ;
    ns1:section "K.3.6" .

ns1:F_K.3.7_SECOND_ORDER_MP a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "M_os = exp(−πζ/sqrt(1−ζ²))·100%" ;
    ns1:name "F_K.3.7_SECOND_ORDER_MP" ;
    ns1:section "K.3.7" .

ns1:F_K.3.8_SECOND_ORDER_BW a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "BW = ω_n·sqrt(1−2ζ²+sqrt(4ζ⁴−4ζ²+2))" ;
    ns1:name "F_K.3.8_SECOND_ORDER_BW" ;
    ns1:section "K.3.8" .

ns1:F_K.3.9_PEAK_TIME a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "t_pk = π/ω_d" ;
    ns1:name "F_K.3.9_PEAK_TIME" ;
    ns1:section "K.3.9" .

ns1:F_K.3_GAIN_MARGIN a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "P3（GM ≥ 10 dB）" ;
    ns1:name "F_K.3_GAIN_MARGIN" ;
    ns1:section "K.3" .

ns1:F_K.4.2_TYPE_II a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "G_c(s) = K_c·(1+s/ω_z)/[s(1+s/ω_p)]" ;
    ns1:name "F_K.4.2_TYPE_II" ;
    ns1:section "K.4.2" .

ns1:F_K.4.3_ZERO_PLACEMENT a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "ω_z = 1/(R_ESR·C_out)" ;
    ns1:name "F_K.4.3_ZERO_PLACEMENT" ;
    ns1:section "K.4.3" .

ns1:F_K.4.4_TYPE_III a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "G_c(s) = K_c(1+s/ω_z1)(1+s/ω_z2)/[s(1+s/ω_p1)(1+s/ω_p2)]" ;
    ns1:name "F_K.4.4_TYPE_III" ;
    ns1:section "K.4.4" .

ns1:F_K.4.5_HIGH_FREQ_POLE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "ω_p2 ∈ [2π·f_c, 2π·f_sw]，工程取 ≈ 2π·f_sw" ;
    ns1:name "F_K.4.5_HIGH_FREQ_POLE" ;
    ns1:section "K.4.5" .

ns1:F_K.5.1_ROUTH_3RD_ORDER a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "a₃,a₂,a₁,a₀ > 0 且 a₂·a₁ > a₃·a₀" ;
    ns1:name "F_K.5.1_ROUTH_3RD_ORDER" ;
    ns1:section "K.5.1" .

ns1:F_K.5.2_LYAPUNOV_LTI a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:name "F_K.5.2_LYAPUNOV_LTI" ;
    ns1:section "K.5.2" .

ns1:F_K.6.3_IMPEDANCE_RATIO a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "< \\" ;
    ns1:name "F_K.6.3_IMPEDANCE_RATIO" ;
    ns1:section "K.6.3" .

ns1:F_K.7.2_CROSSOVER_LIMITS a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "f_c ≤ min(f_sw/10, f_RHPZ/5, f_esr/3)" ;
    ns1:name "F_K.7.2_CROSSOVER_LIMITS" ;
    ns1:section "K.7.2" .

ns1:F_K.7_SAMPLING_DELAY_PHASE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "Δφ = 360°·f/f_sw" ;
    ns1:name "F_K.7_SAMPLING_DELAY_PHASE" ;
    ns1:section "K.7" .

ns1:F_K.8_1_MEASUREMENT_PM a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "实测 PM ≥ 45°" ;
    ns1:name "F_K.8_1_MEASUREMENT_PM" ;
    ns1:section "K.8" .

ns1:F_K.8_2_MEASUREMENT_GM a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "K" ;
    ns1:expr "实测 GM ≥ 10 dB" ;
    ns1:name "F_K.8_2_MEASUREMENT_GM" ;
