    ns1:name "F_W.1.2_KVL" ;
    ns1:section "W.1.2" .

ns1:F_W.1.3_FULL_CURRENT_LAW a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "∮_S (J + ∂D/∂t)·n̂ dS = 0" ;
