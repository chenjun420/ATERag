ns1:F_W.6.15_SETUP_HOLD_VIOLATION a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:name "F_W.6.15_SETUP_HOLD_VIOLATION" ;
    ns1:section "W.6.15" .

