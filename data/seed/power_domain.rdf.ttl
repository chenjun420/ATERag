    ns1:expr "1 FIT = 1 failure / 10⁹ h" ;
    ns1:name "F_W.12.16_FAIL_RATE_CONVERSION" ;
    ns1:section "W.12.16" .

ns1:F_W.12.17_AGING_RATE a ns1:Formula ;
    ns1:authority_kind "unverified" ;
    ns1:domain "W" ;
    ns1:expr "−dR/dt = γR，R(t)=R₀e^{−γt}" ;
