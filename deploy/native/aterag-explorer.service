[Unit]
Description=ATERag 知识门面 (Semantica Explorer UI + /aterag REST)
Documentation=file:///opt/aterag/README.md
# 只依赖本机 PostgreSQL: 图谱在**启动时**从种子 JSON + PG 现读现建
# (aterag.kg.graph), 没有任何外部网络依赖; legacy Qdrant 已随 ADR-014 整体移除。
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=aterag
Group=aterag
WorkingDirectory=/opt/aterag
# .env 内含 API Key 与 EXPLORER_API_KEY, 权限 600 属主 aterag
EnvironmentFile=/opt/aterag/.env
# 控制台/日志统一 UTF-8 (避免中文知识/规格书名乱码)
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONUNBUFFERED=1
# 源码以 src 布局直挂, 改代码后 systemctl restart 即可生效, 无需重装包
Environment=PYTHONPATH=/opt/aterag/src
# 端口取自 .env 的 EXPLORER_PORT (默认 8090)。
#
# 刻意用模块入口而不是 uvicorn CLI: 顶层 app 的 lifespan 里要进入 Explorer
# 子 app 的 lifespan(Starlette 的 Mount 不传播它, 少了这一步 /api/graph/*
# 会全部 503 而 /api/health 照样 200), 那是 aterag.api.explorer.create_app
# 里的组装逻辑, 只有走模块入口才会经过。
ExecStart=/opt/aterag/.venv/bin/python -m aterag.api.explorer
Restart=always
RestartSec=10
TimeoutStopSec=30
# 启动时要读种子 + 建图, 比 MCP 慢; 给足时间再判定失败
TimeoutStartSec=180
# 日志: journalctl 之外额外落盘, 便于板卡侧排障
StandardOutput=append:/var/log/aterag/explorer.log
StandardError=append:/var/log/aterag/explorer.err
# 加固: 禁提权 / 私有 tmp / 只读系统分区 (可写路径仅 /opt/aterag 与 /var/log/aterag)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/aterag /var/log/aterag

[Install]
WantedBy=multi-user.target
