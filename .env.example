# ATERag 环境配置模板
# 复制为 .env 后填写真实值。所有配置仅在此处维护, 代码零硬编码。

# ---- LLM (OpenAI 兼容 chat completions; 模型名后期更换只需改这里) ----
LLM_BASE=https://llm-sy33nhdkv5053c8g.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-flash-2026-07-15
LLM_API_KEY=sk-xxxx

# ---- Embedding (供应商可换; 协议自动识别, 可用 EMBED_PROTOCOL 覆盖) ----
# 识别规则: URL 含 /compatible-mode/v1 -> openai 协议
#           URL 含 /api/v1/services/embeddings -> dashscope 原生协议
EMBED_BASE=https://llm-sy33nhdkv5053c8g.cn-beijing.maas.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
EMBED_MODEL=qwen3.7-text-embedding
EMBED_API_KEY=sk-xxxx
# 可选覆盖: openai | dashscope (默认 auto)
#EMBED_PROTOCOL=auto
# 批量上限 (按供应商文档调整)
EMBED_BATCH_SIZE=10
# 可选: 显式指定维度 (默认启动时探针实测)
#EMBED_DIM=2560

# ---- 存储 (192.168.5.24, 唯一后端, 禁止本地降级) ----
POSTGRES_DSN=postgresql://powerspec:<password>@192.168.5.24:5432/power_specs
QDRANT_URL=http://192.168.5.24:6333
QDRANT_COLLECTION=lightrag_vectors

# ---- Knowledge 分层 ----
REGISTRY_PATH=registry.yaml
DOMAIN_RULES_DIR=domain_rules
COMMON_WORKSPACE=_common
DOMAIN_WORKSPACE_PREFIX=_domain_

# ---- MCP 服务 ----
MCP_HOST=0.0.0.0
MCP_PORT=8080
